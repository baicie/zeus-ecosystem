{
  "name": "@zeus-ecosystem/ai-workbench",
  "type": "module",
  "private": true,
  "description": "Zeus Native AI Workbench shell over the trusted AI reference host.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:p0": "node scripts/run-with-sqlite.mjs scripts/checks/check-ai-workbench-p0.ts",
    "check:byok": "node scripts/run-with-sqlite.mjs scripts/checks/check-ai-workbench-byok.ts",
    "check:csp": "tsx scripts/checks/check-ai-workbench-csp.ts",
    "check:gates": "pnpm check:byok && pnpm check:csp && pnpm check:p0",
    "check:live": "tsx scripts/checks/check-ai-workbench-live.ts"
  },
  "dependencies": {
    "@zeus-js/runtime-dom": "0.2.0-rc.5",
    "@zeus-js/zeus": "0.2.0-rc.5",
    "@zeus-web/ai-adapters": "0.1.0-beta.35",
    "@zeus-web/ai-core": "0.1.0-beta.35",
    "@zeus-web/ai-primitives": "0.1.0-beta.35",
    "@zeus-web/ai-wc": "0.1.0-beta.35"
  },
  "devDependencies": {
    "@zeus-js/vite-plugin": "0.0.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.9",
    "jsdom": "29.1.1",
    "@playwright/test": "1.57.0",
    "tsx": "4.22.4",
    "@types/node": "26.0.0"
  }
}
