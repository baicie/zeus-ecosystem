    "@zeus-js/runtime-dom": "0.2.0-rc.8",
    "@zeus-js/signal": "0.2.0-rc.8",
    "@zeus-js/zeus": "0.2.0-rc.8",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
