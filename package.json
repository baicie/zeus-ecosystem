{
  "name": "zeus-ecosystem",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent applications and integration evidence for Zeus",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "check": "node scripts/validate-repository.mjs && node --test scripts/__tests__/*.test.mjs",
    "check:policy": "node scripts/validate-repository.mjs",
    "check:registry": "node scripts/check-published-core.mjs",
    "check:core-consumer": "node scripts/core-consumer-smoke.mjs",
    "check:pair": "node scripts/verify-published-pair.mjs",
    "check:matrix": "node scripts/published-consumer-matrix.mjs",
    "check:published-fixtures": "node scripts/check-published-fixtures.mjs",
    "test:e2e:published": "playwright test",
    "check:admin-browser": "pnpm --filter @zeus-ecosystem/admin run check:browser",
    "check:admin-visual": "pnpm --filter @zeus-ecosystem/admin run check:visual",
    "check:provenance": "tsx scripts/release/verify-provenance.mjs",
    "check:provenance:offline": "tsx scripts/release/verify-provenance.mjs --product admin --offline",
    "check:candidate": "node scripts/release/release-candidate.mjs",
    "check:cleanup": "node scripts/release/cleanup-preflight.mjs",
    "check:cutover-preflight": "node scripts/release/cutover-preflight.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "typescript": "5.9.3",
    "sigstore": "4.1.1"
  }
}
